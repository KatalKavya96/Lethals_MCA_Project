// P3 - mostly non-memory instructions (compute-heavy)
// Also tests that a write to an unmapped offset (0x90) is blocked in both designs.
// In the shared design offset 0x90 would land on absolute 0x10 = inside the program.
// N = 16 instructions, M = 4 touch data memory
30000100   // 00 LDI   1
00000000   // 01 NOP
00000000   // 02 NOP
30000200   // 03 LDI   2
00000000   // 04 NOP
00000000   // 05 NOP
00000000   // 06 NOP
30000300   // 07 LDI   3
20000030   // 08 STORE [0x30]
30006300   // 09 LDI   0x63
20000090   // 0A STORE [0x90]   unmapped: must be ignored
00000000   // 0B NOP
00000000   // 0C NOP
10000030   // 0D LOAD  [0x30]
20000070   // 0E STORE [0x70]  -> OUT
F0000000   // 0F HALT
